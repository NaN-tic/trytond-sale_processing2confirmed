msgctxt "model:res.group,name:group_sale_process2draft"
msgid "Sales process to draft"
msgstr "Ventas en proceso a borrador"

msgctxt "model:ir.message,text:msg_user_group_process2draft"
msgid ""
"Only the users of the group \"Sales process to draft\" can draft a "
"processing sale."
msgstr ""
"Sólo los usuarios del grupo \"Ventas en proceso a borrador\" pueden cambiar "
"una venta en proceso a borrador."

msgctxt "model:ir.message,text:msg_sale_draft_drop_shipment"
msgid "Sale \"%(sale)s\" cannot be returned to draft because it has shipped or completed direct shipments."
msgstr "La venta \"%(sale)s\" no se puede pasar a borrador porque tiene envíos directos expedidos o finalizados."
